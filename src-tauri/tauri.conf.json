{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XerifeTV",
  "version": "0.1.0",
  "identifier": "com.xerifetv.app",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:4300",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/XerifeTVWeb/browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "XerifeTV",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "useHttpsScheme": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-web-security --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["PortugueseBR"]
      }
    }
  }
}
